# ============================================================================
# Backend (auth / users / RBAC) - copy to backend/.env and edit.
#
# DB_* / REDIS_* are shared with docker-compose and normally live in the
# repo-root .env. This file is loaded SECOND and overrides the root .env, so
# put backend-only secrets (JWT keys) here. NEVER commit backend/.env.
# ============================================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_FORMAT=dev

# ---- Database (mysql2/promise) ----
# Usually inherited from the repo-root .env; override here only if needed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=internal_comms
DB_USER=app_rw
DB_PASSWORD=change-me-app
DB_CONNECTION_LIMIT=10

# ---- Access tokens (RS256) ----
# Provide PEM either inline (escape newlines as \n) ...
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# ... or as file paths generated with `npm run keys`.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ISSUER=internal-comms-portal
JWT_AUDIENCE=internal-comms-portal-app
ACCESS_TOKEN_TTL=15m

# ---- Refresh tokens (opaque, rotating) ----
REFRESH_TOKEN_TTL_DAYS=30

# ---- Login lockout ----
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# ---- Argon2id parameters (tune to your hardware) ----
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- Login rate limiting ----
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX=10
