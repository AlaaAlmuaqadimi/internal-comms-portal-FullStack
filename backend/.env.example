# ============================================================================
# Backend (auth / users / RBAC) - copy to backend/.env and edit.
#
# DB_* / REDIS_* are shared with docker-compose and normally live in the
# repo-root .env. This file is loaded SECOND and overrides the root .env, so
# put backend-only secrets (JWT keys) here. NEVER commit backend/.env.
# ============================================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_FORMAT=dev

# ---- Database (mysql2/promise) ----
# Usually inherited from the repo-root .env; override here only if needed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=internal_comms
DB_USER=app_rw
DB_PASSWORD=change-me-app
DB_CONNECTION_LIMIT=10

# ---- Access tokens (RS256) ----
# Provide PEM either inline (escape newlines as \n) ...
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# ... or as file paths generated with `npm run keys`.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ISSUER=internal-comms-portal
JWT_AUDIENCE=internal-comms-portal-app
ACCESS_TOKEN_TTL=15m

# ---- Refresh tokens (opaque, rotating) ----
REFRESH_TOKEN_TTL_DAYS=30

# ---- Login lockout ----
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# ---- Argon2id parameters (tune to your hardware) ----
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- Login rate limiting ----
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX=10
# Token refresh (same window). Larger: every device refreshes ~4x/hour.
REFRESH_RATE_MAX=300

# ---- Call invitation rate limiting (per signed-in user) ----
CALL_INVITE_RATE_WINDOW_MINUTES=1
CALL_INVITE_RATE_MAX=10

# ---- Phase B call signalling ----
# Keep false until the mobile build that speaks socket.io has shipped. The
# REST history endpoints keep working either way; only the socket and ticket
# endpoint are gated.
CALL_SIGNALING_ENABLED=false
CALL_RING_TIMEOUT_SECONDS=45
CALL_DISCONNECT_GRACE_SECONDS=30
SIGNALING_TICKET_TTL_SECONDS=120
SIGNALING_TICKET_RATE_WINDOW_MINUTES=1
SIGNALING_TICKET_RATE_MAX=30

# ICE servers returned with each signalling ticket (comma-separated lists).
# Leadership calls are relay-only and cannot connect without TURN.
# TURN uses coturn's `use-auth-secret` scheme; TURN_SHARED_SECRET must match
# coturn's `static-auth-secret`.
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
# Hosted TURN (e.g. Metered): fixed credentials, used only when
# TURN_SHARED_SECRET is empty. Example:
#   TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Phase D: incoming-call pushes (Firebase Cloud Messaging) ----
# Off by default. Put the Firebase service-account JSON in backend/secrets/
# (git-ignored, never commit it) and set PUSH_ENABLED=true.
PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
# true: the push shows the caller's name (redacted label for leadership).
# false: Google only sees the call id; the phone shows a generic title.
PUSH_SHOW_CALLER_NAME=false
