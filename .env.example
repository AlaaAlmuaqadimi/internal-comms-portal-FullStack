# ============================================================================
# Copy to .env and replace every "change-me" value.
# NEVER commit .env - it is git-ignored. Use real secrets from your KMS/vault.
# ============================================================================

# ---- MySQL (docker-compose) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=internal_comms
MYSQL_USER=app_rw
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# ---- Redis (docker-compose) ----
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# ---- Import script (database/scripts/import-legacy.js) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=internal_comms
DB_USER=app_rw
DB_PASSWORD=change-me-app
DB_CONNECTION_LIMIT=10

# Optional: folder holding the legacy JSON files
# (org.json, kitchens.json, accounts.json, users.json).
# When unset, the script reads them from git history (commit dd2ee3a).
# LEGACY_DATA_DIR=./database/legacy
