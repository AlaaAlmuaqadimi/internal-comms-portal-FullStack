# ============================================================================
# MySQL 8.0 server hardening - TEMPLATE (merge into mysqld.cnf)
# Keys/certs referenced with placeholders; supply real paths at deploy time.
# ============================================================================

[mysqld]
# --- Strict, predictable SQL behaviour ---
sql_mode = STRICT_ALL_TABLES,NO_ENGINE_SUBSTITUTION,ERROR_FOR_DIVISION_BY_ZERO,NO_ZERO_DATE,NO_ZERO_IN_DATE

# --- Encryption in transit ---
require_secure_transport = ON
tls_version = TLSv1.2,TLSv1.3
ssl_ca   = /etc/mysql/certs/ca.pem
ssl_cert = /etc/mysql/certs/server-cert.pem
ssl_key  = /etc/mysql/certs/server-key.pem

# --- Lock down local IO / file access ---
local_infile = OFF
secure_file_priv = /var/lib/mysql-files

# --- Binlog / recovery (keep for PITR; enable encryption at rest) ---
log_bin = /var/log/mysql/mysql-bin
binlog_format = ROW
binlog_row_image = MINIMAL
# MySQL 8.0.14+: encrypt binary logs (Enterprise/Percona); else rely on disk encryption
# binlog_encryption = ON

# --- Do not expose metadata unnecessarily ---
# skip_name_resolve = ON

[client]
default-character-set = utf8mb4
