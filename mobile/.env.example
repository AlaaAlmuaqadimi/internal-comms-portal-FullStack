# Copy to mobile/.env and set EXPO_PUBLIC_API_BASE_URL.
# Expo only inlines env vars prefixed with EXPO_PUBLIC_ into the client bundle.
#
#   Physical device (same Wi-Fi): http://<your-machine-LAN-IP>:4000
#   Android emulator:             http://10.0.2.2:4000
#   iOS simulator:                http://localhost:4000
#
# Leave empty to run the app in mock mode (no backend required).
EXPO_PUBLIC_API_BASE_URL=
