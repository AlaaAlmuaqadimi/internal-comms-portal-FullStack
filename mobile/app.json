{
  "expo": {
    "name": "بوابة التواصل الإداري",
    "slug": "internal-comms-portal",
    "scheme": "internalcommsportal",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ly.call.comms",
      "buildNumber": "1.0.0",
      "infoPlist": {},
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14283f"
      },
      "package": "ly.call.comms",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "plugins": [
      "expo-status-bar",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#14283f"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لإجراء المكالمات الصوتية.",
          "cameraPermission": "يستخدم التطبيق الكاميرا لصورة الملف الشخصي فقط."
        }
      ],
      [
        "expo-callkit-telecom",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لإجراء المكالمات الصوتية.",
          "incomingCallTimeout": 45,
          "outgoingCallTimeout": 60,
          "fulfillAnswerCallTimeout": 45,
          "supportsVideo": false,
          "includesCallsInRecents": false,
          "notificationStringsAndroid": {
            "default": {
              "channelIncomingName": "المكالمات الواردة",
              "channelIncomingDescription": "إشعارات المكالمات الواردة",
              "channelOngoingName": "المكالمات الجارية",
              "channelOngoingDescription": "إشعارات المكالمات الجارية",
              "incomingCall": "مكالمة واردة",
              "dialing": "جارٍ الاتصال…",
              "ongoingCall": "مكالمة جارية",
              "callEnded": "انتهت المكالمة",
              "unknownCaller": "مكالمة داخلية",
              "answer": "رد",
              "decline": "رفض"
            },
            "en": {
              "channelIncomingName": "Incoming calls",
              "channelIncomingDescription": "Notifications for incoming calls",
              "channelOngoingName": "Ongoing calls",
              "channelOngoingDescription": "Notifications for active calls",
              "incomingCall": "Incoming call",
              "dialing": "Calling…",
              "ongoingCall": "Ongoing call",
              "callEnded": "Call ended",
              "unknownCaller": "Internal call",
              "answer": "Answer",
              "decline": "Decline"
            }
          },
          "androidEventReceiver": ".CallEndedReceiver"
        }
      ],
      "./plugins/withCallEndedReceiver",
      "./plugins/withCallLockScreen",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#14283f"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "75088367-edd2-41a3-bea1-8d8ee1f1cf7a"
      }
    }
  }
}
