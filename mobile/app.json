{
  "expo": {
    "name": "بوابة التواصل الإداري",
    "slug": "internal-comms-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.internalcommsportal",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14283f"
      },
      "package": "com.yourcompany.internalcommsportal",
      "versionCode": 1
    },
    "plugins": [
      "expo-status-bar",
      "expo-localization",
      "expo-font",
      ["expo-splash-screen", {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#14283f"
      }]
    ]
  }
}
