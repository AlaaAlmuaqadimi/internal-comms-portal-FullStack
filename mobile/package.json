{
  "name": "internal-comms-portal-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:tunnel": "node scripts/patch-expo-tunnel-scheme.mjs && expo start --dev-client --tunnel",
    "start:go:tunnel": "node scripts/patch-expo-tunnel-scheme.mjs && expo start --go --tunnel",
    "start:go:tunnel:ngrok": "node scripts/patch-expo-tunnel-scheme.mjs && expo start --go --tunnel ngrok",
    "patch:expo": "node scripts/patch-expo-tunnel-scheme.mjs",
    "postinstall": "node scripts/patch-expo-tunnel-scheme.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "backend": "node index.js",
    "dev": "concurrently \"npm run backend\" \"expo start --dev-client\"",
    "test:calls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/call-machine-test.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/call-session-test.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/security-code-test.mjs",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/auth-refresh-test.mjs"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-incall-manager": "^4.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-webrtc": "^155.0.1",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "babel-preset-expo": "~58.0.0"
  },
  "private": true
}
